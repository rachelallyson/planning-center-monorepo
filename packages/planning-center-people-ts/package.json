{
    "name": "@rachelallyson/planning-center-people-ts",
    "version": "4.0.0",
    "description": "A strictly typed TypeScript client for Planning Center Online People API with comprehensive functionality and enhanced developer experience",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "scripts": {
        "build": "tsc",
        "dev": "tsc --watch",
        "clean": "rm -rf dist",
        "prebuild": "npm run clean",
        "test": "jest",
        "test:unit": "jest",
        "test:ci": "jest --ci --coverage --watchAll=false",
        "test:integration": "vitest run -c vitest.integration.config.ts",
        "typecheck:test": "tsc --noEmit -p tsconfig.test.json",
        "docs": "typedoc",
        "prepublishOnly": "npm run build",
        "prepare": "ts-patch install"
    },
    "keywords": [
        "planning-center",
        "planning-center-online",
        "pco",
        "api",
        "typescript",
        "json-api",
        "people",
        "church",
        "client",
        "sdk",
        "rate-limiting",
        "error-handling",
        "fluent-api",
        "event-system"
    ],
    "author": "Rachel Allyson",
    "license": "MIT",
    "devDependencies": {
        "@babel/core": "^7.29.0",
        "@babel/preset-env": "^7.29.0",
        "@ryoppippi/unplugin-typia": "^2.6.5",
        "@types/jest": "^30.0.0",
        "@types/node": "^25.0.10",
        "babel-jest": "^30.2.0",
        "dotenv": "^17.2.3",
        "jest": "^30.2.0",
        "ts-jest": "^29.4.6",
        "ts-patch": "^3.2.0",
        "tslib": "^2.8.1",
        "typedoc": "^0.28.16",
        "typedoc-plugin-markdown": "^4.9.0",
        "typescript": "^5.9.3",
        "typia": "^11.0.0",
        "vite": "^6.0.0",
        "vitest": "^3.0.0"
    },
    "files": [
        "dist",
        "README.md",
        "LICENSE",
        "CHANGELOG.md"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/rachelallyson/planning-center-monorepo.git"
    },
    "bugs": {
        "url": "https://github.com/rachelallyson/planning-center-monorepo/issues"
    },
    "homepage": "https://github.com/rachelallyson/planning-center-monorepo#readme",
    "engines": {
        "node": ">=16.0.0"
    },
    "publishConfig": {
        "access": "public"
    },
    "dependencies": {
        "@rachelallyson/planning-center-base-ts": "^2.0.0",
        "form-data": "^4.0.5"
    }
}
