# PCO API Integration Test Configuration
# Copy this file to .env.test and fill in your actual credentials

# Option 1: Personal Access Token (recommended for testing)
# PCO_PERSONAL_ACCESS_TOKEN=your_pat_here
# PCO_PERSONAL_ACCESS_SECRET=your_pat_secret_here

# Option 2: OAuth 2.0 (access token + optional refresh)
# PCO_ACCESS_TOKEN=your_oauth_token_here
# PCO_REFRESH_TOKEN=your_refresh_token_here
# PCO_APP_ID=your_app_id_here
# PCO_APP_SECRET=your_app_secret_here

# Option 3: Basic Auth (App ID + Secret only)
# PCO_APP_ID=your_app_id_here
# PCO_APP_SECRET=your_app_secret_here

# Optional: Override default rate limiting for testing
# PCO_RATE_LIMIT_MAX=90
# PCO_RATE_LIMIT_WINDOW=20000
