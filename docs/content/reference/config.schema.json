{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "PcoClientConfig",
    "type": "object",
    "required": [
        "auth"
    ],
    "properties": {
        "auth": {
            "oneOf": [
                {
                    "type": "object",
                    "required": [
                        "type",
                        "personalAccessToken"
                    ],
                    "properties": {
                        "type": {
                            "const": "personal_access_token"
                        },
                        "personalAccessToken": {
                            "type": "string",
                            "minLength": 1
                        }
                    },
                    "additionalProperties": false
                },
                {
                    "type": "object",
                    "required": [
                        "type",
                        "accessToken",
                        "refreshToken",
                        "onRefresh",
                        "onRefreshFailure"
                    ],
                    "properties": {
                        "type": {
                            "const": "oauth"
                        },
                        "accessToken": {
                            "type": "string",
                            "minLength": 1
                        },
                        "refreshToken": {
                            "type": "string",
                            "minLength": 1
                        },
                        "onRefresh": {
                            "type": "function"
                        },
                        "onRefreshFailure": {
                            "type": "function"
                        },
                        "clientId": {
                            "type": "string"
                        },
                        "clientSecret": {
                            "type": "string"
                        }
                    },
                    "additionalProperties": false
                },
                {
                    "type": "object",
                    "required": [
                        "type",
                        "appId",
                        "appSecret"
                    ],
                    "properties": {
                        "type": {
                            "const": "basic"
                        },
                        "appId": {
                            "type": "string",
                            "minLength": 1
                        },
                        "appSecret": {
                            "type": "string",
                            "minLength": 1
                        }
                    },
                    "additionalProperties": false
                }
            ]
        },
        "baseURL": {
            "type": "string",
            "format": "uri"
        },
        "timeout": {
            "type": "number",
            "minimum": 0,
            "default": 30000
        },
        "headers": {
            "type": "object",
            "additionalProperties": {
                "type": "string"
            }
        },
        "debug": {
            "oneOf": [
                {
                    "type": "boolean"
                },
                {
                    "type": "object",
                    "properties": {
                        "prefix": {
                            "type": "string"
                        },
                        "includePayloads": {
                            "type": "boolean"
                        },
                        "onLog": {
                            "type": "function"
                        }
                    },
                    "additionalProperties": false
                }
            ]
        }
    },
    "additionalProperties": false
}